Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; img-src * data: blob:; connect-src *; font-src * data:; media-src *"

  # index.html nunca deve ficar em cache — é ele que aponta pros arquivos
  # JS/CSS com hash de cada build. Sem isso, quem tiver uma cópia antiga
  # guardada (navegador ou proxy) fica preso numa versão velha do site até
  # forçar um hard-refresh.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
